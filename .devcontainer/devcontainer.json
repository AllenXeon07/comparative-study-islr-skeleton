{
    "name": "GPU ML Development",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "dev-container",
    "workspaceFolder": "/app",
  
    // Features to add to the container (Optional but helpful)
    "features": {
      "ghcr.io/devcontainers/features/common-utils:1": {
        "installZsh": true,
        "configureZshAsDefaultShell": true
      }
    },
  
    // Extension IDs to install inside the container
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-toolsai.jupyter",
          "nvidia.nsight-vscode-edition"
        ]
      }
    },
  
    // Use 'root' to match the Dockerfile or a specific user
    "remoteUser": "root"
  }